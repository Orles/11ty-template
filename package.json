  },
  "homepage": "https://github.com/Orles/portfolio#readme",
  "dependencies": {
    "@11ty/eleventy": "^3.1.6",
    "swiper": "^14.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "prettier-plugin-nunjucks": "^0.2.1",
    "sass-embedded": "^1.105.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.1",
    "tsx": "^4.23.15",
